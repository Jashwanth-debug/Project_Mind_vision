# MindVision Clinical AI - Environment Configuration

# Server Port (Default: 5001)
PORT=5001

# JWT Secret for Clinician / Provider Authentication (Optional: ephemeral fallback generated if unset)
# JWT_SECRET_KEY=your-secure-jwt-secret-here

# ==============================================================================
# Cloud Neural TTS Configuration (Azure Cognitive Services, OpenAI, ElevenLabs)
# ==============================================================================
# Active Provider: "azure" (recommended), "openai", or "elevenlabs"
TTS_PROVIDER=azure

# --- 1. Azure Cognitive Services Speech (Recommended for Clinical Empathy) ---
# AZURE_SPEECH_KEY=your-azure-speech-resource-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AriaNeural
AZURE_SPEECH_STYLE=chat

# --- 2. OpenAI Text-To-Speech (Alternative) ---
# OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# --- 3. ElevenLabs Neural Voices (Alternative) ---
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
